{
  "$defs": {
    "AI": {
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "default": "deterministic",
          "enum": [
            "deterministic",
            "host",
            "http",
            "native"
          ],
          "title": "Strategy",
          "type": "string"
        },
        "endpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Endpoint"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "context_bytes": {
          "default": 12000,
          "maximum": 32000,
          "minimum": 1000,
          "title": "Context Bytes",
          "type": "integer"
        }
      },
      "title": "AI",
      "type": "object"
    },
    "BrowserMutation": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "enum": [
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ],
          "title": "Method",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "method",
        "path"
      ],
      "title": "BrowserMutation",
      "type": "object"
    },
    "BrowserStep": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "fill",
            "click",
            "goto",
            "expect_text",
            "expect_path"
          ],
          "title": "Action",
          "type": "string"
        },
        "selector": {
          "default": "body",
          "maxLength": 256,
          "title": "Selector",
          "type": "string"
        },
        "value": {
          "default": "",
          "maxLength": 1024,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "action"
      ],
      "title": "BrowserStep",
      "type": "object"
    },
    "BrowserWorkflow": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Headers",
          "type": "object"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/BrowserStep"
          },
          "maxItems": 20,
          "title": "Steps",
          "type": "array"
        },
        "max_requests": {
          "default": 8,
          "maximum": 30,
          "minimum": 1,
          "title": "Max Requests",
          "type": "integer"
        },
        "allowed_mutations": {
          "items": {
            "$ref": "#/$defs/BrowserMutation"
          },
          "maxItems": 8,
          "title": "Allowed Mutations",
          "type": "array"
        },
        "rollback_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rollback Path"
        },
        "synthetic": {
          "default": true,
          "title": "Synthetic",
          "type": "boolean"
        },
        "disposable": {
          "default": false,
          "title": "Disposable",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "path"
      ],
      "title": "BrowserWorkflow",
      "type": "object"
    },
    "Execution": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "default": "auto",
          "enum": [
            "auto",
            "docker",
            "macos",
            "bubblewrap"
          ],
          "title": "Backend",
          "type": "string"
        },
        "command": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Command",
          "type": "array"
        },
        "service": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service"
        },
        "port": {
          "default": 8765,
          "maximum": 65535,
          "minimum": 1024,
          "title": "Port",
          "type": "integer"
        },
        "health_path": {
          "default": "/health",
          "title": "Health Path",
          "type": "string"
        },
        "startup_timeout": {
          "default": 20,
          "maximum": 180,
          "minimum": 1,
          "title": "Startup Timeout",
          "type": "integer"
        },
        "image": {
          "default": "python:3.13-slim",
          "title": "Image",
          "type": "string"
        },
        "environment": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Environment",
          "type": "object"
        },
        "existing_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Existing Url"
        },
        "existing_identity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Existing Identity"
        },
        "compose_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Compose File"
        },
        "seeds": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 8,
          "title": "Seeds",
          "type": "object"
        },
        "migrations": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "maxProperties": 8,
          "title": "Migrations",
          "type": "object"
        },
        "dependency_lock": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dependency Lock"
        },
        "use_dependencies": {
          "default": true,
          "title": "Use Dependencies",
          "type": "boolean"
        }
      },
      "title": "Execution",
      "type": "object"
    },
    "FuzzTarget": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "parameter": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$",
          "title": "Parameter",
          "type": "string"
        },
        "input_schema": {
          "additionalProperties": true,
          "title": "Input Schema",
          "type": "object"
        },
        "max_cases": {
          "default": 3,
          "maximum": 8,
          "minimum": 1,
          "title": "Max Cases",
          "type": "integer"
        },
        "expected_invalid_status": {
          "items": {
            "type": "integer"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Expected Invalid Status",
          "type": "array"
        },
        "expected_valid_status": {
          "items": {
            "type": "integer"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Expected Valid Status",
          "type": "array"
        }
      },
      "required": [
        "id",
        "path",
        "parameter"
      ],
      "title": "FuzzTarget",
      "type": "object"
    },
    "Limits": {
      "additionalProperties": false,
      "properties": {
        "duration_seconds": {
          "default": 300,
          "maximum": 3600,
          "minimum": 5,
          "title": "Duration Seconds",
          "type": "integer"
        },
        "max_requests": {
          "default": 100,
          "maximum": 1000,
          "minimum": 1,
          "title": "Max Requests",
          "type": "integer"
        },
        "requests_per_second": {
          "default": 2,
          "exclusiveMinimum": 0,
          "maximum": 10,
          "title": "Requests Per Second",
          "type": "number"
        },
        "response_bytes": {
          "default": 65536,
          "maximum": 1048576,
          "minimum": 256,
          "title": "Response Bytes",
          "type": "integer"
        },
        "log_bytes": {
          "default": 262144,
          "maximum": 1048576,
          "minimum": 1024,
          "title": "Log Bytes",
          "type": "integer"
        },
        "storage_mb": {
          "default": 64,
          "maximum": 512,
          "minimum": 8,
          "title": "Storage Mb",
          "type": "integer"
        },
        "memory_mb": {
          "default": 512,
          "maximum": 2048,
          "minimum": 128,
          "title": "Memory Mb",
          "type": "integer"
        },
        "processes": {
          "default": 32,
          "maximum": 128,
          "minimum": 4,
          "title": "Processes",
          "type": "integer"
        },
        "cpus": {
          "default": 1,
          "exclusiveMinimum": 0,
          "maximum": 4,
          "title": "Cpus",
          "type": "number"
        },
        "max_concurrent": {
          "default": 2,
          "maximum": 4,
          "minimum": 1,
          "title": "Max Concurrent",
          "type": "integer"
        },
        "retries": {
          "default": 0,
          "maximum": 2,
          "minimum": 0,
          "title": "Retries",
          "type": "integer"
        },
        "model_tokens": {
          "default": 0,
          "maximum": 1000000,
          "minimum": 0,
          "title": "Model Tokens",
          "type": "integer"
        },
        "model_calls": {
          "default": 16,
          "maximum": 64,
          "minimum": 1,
          "title": "Model Calls",
          "type": "integer"
        },
        "model_cost_usd": {
          "default": 0,
          "maximum": 20,
          "minimum": 0,
          "title": "Model Cost Usd",
          "type": "number"
        },
        "max_findings": {
          "default": 500,
          "maximum": 2000,
          "minimum": 10,
          "title": "Max Findings",
          "type": "integer"
        }
      },
      "title": "Limits",
      "type": "object"
    },
    "Scenario": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "category": {
          "enum": [
            "authorization",
            "authentication",
            "validation",
            "business_logic",
            "tenant_isolation"
          ],
          "title": "Category",
          "type": "string"
        },
        "method": {
          "default": "GET",
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ],
          "title": "Method",
          "type": "string"
        },
        "owner_headers": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Owner Headers",
          "type": "object"
        },
        "actor_headers": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Actor Headers",
          "type": "object"
        },
        "owner_status": {
          "default": 200,
          "maximum": 599,
          "minimum": 100,
          "title": "Owner Status",
          "type": "integer"
        },
        "expected_status": {
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "title": "Expected Status",
          "type": "array"
        },
        "marker": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Marker"
        },
        "body": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Body"
        },
        "disposable": {
          "default": false,
          "title": "Disposable",
          "type": "boolean"
        },
        "synthetic": {
          "default": true,
          "title": "Synthetic",
          "type": "boolean"
        },
        "rollback_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rollback Path"
        }
      },
      "required": [
        "id",
        "path",
        "category"
      ],
      "title": "Scenario",
      "type": "object"
    },
    "StatefulWorkflow": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "category": {
          "default": "business_logic",
          "enum": [
            "business_logic",
            "authorization",
            "tenant_isolation",
            "authentication"
          ],
          "title": "Category",
          "type": "string"
        },
        "identities": {
          "additionalProperties": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "title": "Identities",
          "type": "object"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/WorkflowStep"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "rollback": {
          "$ref": "#/$defs/WorkflowStep"
        },
        "synthetic": {
          "const": true,
          "title": "Synthetic",
          "type": "boolean"
        },
        "disposable": {
          "const": true,
          "title": "Disposable",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "identities",
        "steps",
        "rollback",
        "synthetic",
        "disposable"
      ],
      "title": "StatefulWorkflow",
      "type": "object"
    },
    "Tools": {
      "additionalProperties": false,
      "properties": {
        "semgrep": {
          "default": false,
          "title": "Semgrep",
          "type": "boolean"
        },
        "osv_scanner": {
          "default": false,
          "title": "Osv Scanner",
          "type": "boolean"
        },
        "trivy": {
          "default": false,
          "title": "Trivy",
          "type": "boolean"
        },
        "advisory_snapshot": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Advisory Snapshot"
        },
        "advisory_max_age_days": {
          "default": 7,
          "maximum": 365,
          "minimum": 1,
          "title": "Advisory Max Age Days",
          "type": "integer"
        },
        "backend": {
          "default": "auto",
          "enum": [
            "auto",
            "macos",
            "bubblewrap",
            "docker"
          ],
          "title": "Backend",
          "type": "string"
        },
        "images": {
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "enum": [
              "semgrep",
              "osv-scanner",
              "trivy"
            ]
          },
          "title": "Images",
          "type": "object"
        }
      },
      "title": "Tools",
      "type": "object"
    },
    "WorkflowStep": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,31}$",
          "title": "Id",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "method": {
          "default": "GET",
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ],
          "title": "Method",
          "type": "string"
        },
        "identity": {
          "default": "owner",
          "title": "Identity",
          "type": "string"
        },
        "body": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Body"
        },
        "expected_status": {
          "items": {
            "type": "integer"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Expected Status",
          "type": "array"
        },
        "marker": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Marker"
        },
        "capture": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 5,
          "title": "Capture",
          "type": "object"
        },
        "security_assertion": {
          "default": false,
          "title": "Security Assertion",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "path"
      ],
      "title": "WorkflowStep",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1,
      "default": 1,
      "title": "Version",
      "type": "integer"
    },
    "product_name": {
      "default": "Local AppSec Lab",
      "maxLength": 80,
      "minLength": 1,
      "title": "Product Name",
      "type": "string"
    },
    "execution": {
      "$ref": "#/$defs/Execution"
    },
    "limits": {
      "$ref": "#/$defs/Limits"
    },
    "scenarios": {
      "items": {
        "$ref": "#/$defs/Scenario"
      },
      "maxItems": 30,
      "title": "Scenarios",
      "type": "array"
    },
    "tools": {
      "$ref": "#/$defs/Tools"
    },
    "ai": {
      "$ref": "#/$defs/AI"
    },
    "output": {
      "default": ".appsec-lab",
      "title": "Output",
      "type": "string"
    },
    "fail_on": {
      "default": "high",
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "informational"
      ],
      "title": "Fail On",
      "type": "string"
    },
    "categories": {
      "items": {
        "type": "string"
      },
      "title": "Categories",
      "type": "array"
    },
    "offline": {
      "default": true,
      "title": "Offline",
      "type": "boolean"
    },
    "cvss_vectors": {
      "additionalProperties": {
        "type": "string"
      },
      "maxProperties": 100,
      "title": "Cvss Vectors",
      "type": "object"
    },
    "browser": {
      "default": false,
      "title": "Browser",
      "type": "boolean"
    },
    "browser_workflows": {
      "items": {
        "$ref": "#/$defs/BrowserWorkflow"
      },
      "maxItems": 10,
      "title": "Browser Workflows",
      "type": "array"
    },
    "workflows": {
      "items": {
        "$ref": "#/$defs/StatefulWorkflow"
      },
      "maxItems": 10,
      "title": "Workflows",
      "type": "array"
    },
    "fuzz_targets": {
      "items": {
        "$ref": "#/$defs/FuzzTarget"
      },
      "maxItems": 10,
      "title": "Fuzz Targets",
      "type": "array"
    }
  },
  "title": "Config",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
