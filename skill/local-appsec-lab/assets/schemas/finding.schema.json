{
  "$defs": {
    "Source": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "line": {
          "minimum": 1,
          "title": "Line",
          "type": "integer"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "excerpt": {
          "default": "",
          "title": "Excerpt",
          "type": "string"
        },
        "sha256": {
          "default": "",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "line",
        "end_line"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "default": "",
      "title": "Id",
      "type": "string"
    },
    "fingerprint": {
      "default": "",
      "title": "Fingerprint",
      "type": "string"
    },
    "rule": {
      "title": "Rule",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "category": {
      "title": "Category",
      "type": "string"
    },
    "severity": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "informational"
      ],
      "title": "Severity",
      "type": "string"
    },
    "severity_reason": {
      "title": "Severity Reason",
      "type": "string"
    },
    "confidence": {
      "default": "medium",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "state": {
      "default": "candidate",
      "enum": [
        "candidate",
        "confirmed",
        "not_reproduced",
        "false_positive",
        "informational",
        "blocked",
        "not_tested"
      ],
      "title": "State",
      "type": "string"
    },
    "cwe": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cwe"
    },
    "source": {
      "anyOf": [
        {
          "$ref": "#/$defs/Source"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "endpoint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Endpoint"
    },
    "service": {
      "default": "app",
      "title": "Service",
      "type": "string"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "root_cause": {
      "default": "Exact source-level cause is not established by the available evidence.",
      "title": "Root Cause",
      "type": "string"
    },
    "expected": {
      "title": "Expected",
      "type": "string"
    },
    "observed": {
      "title": "Observed",
      "type": "string"
    },
    "evidence": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Evidence",
      "type": "array"
    },
    "verification": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Verification",
      "type": "array"
    },
    "remediation": {
      "default": "",
      "title": "Remediation",
      "type": "string"
    },
    "regression": {
      "default": "",
      "title": "Regression",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "provenance": {
      "default": "builtin",
      "title": "Provenance",
      "type": "string"
    },
    "cvss": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cvss"
    },
    "remediation_details": {
      "additionalProperties": true,
      "title": "Remediation Details",
      "type": "object"
    }
  },
  "required": [
    "rule",
    "title",
    "category",
    "severity",
    "severity_reason",
    "description",
    "expected",
    "observed"
  ],
  "title": "Finding",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
